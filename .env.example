# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Database Settings (Vercel Postgres, Supabase, Neon, or Cloud SQL)
# When deploying to Vercel and attaching Vercel Postgres / Storage, POSTGRES_URL is injected automatically.
POSTGRES_URL=
DATABASE_URL=

# Alternatively, manual Cloud SQL / Postgres credentials:
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_PORT=5432
SQL_SSL=false
